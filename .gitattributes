# Shell scripts must keep LF endings (executed inside Linux containers)
*.sh text eol=lf
# Batch files need CRLF (cmd.exe mis-parses labels/goto with LF-only)
*.bat text eol=crlf
# The Gradle wrapper script runs under sh on Linux and macOS runners, so LF
# whatever core.autocrlf says (gradlew.bat is CRLF through *.bat)
android/gradlew text eol=lf
# Jars (the Gradle wrapper's) are binary: no line-ending conversion
*.jar binary
# SyncTeX samples are read byte for byte (test_synctex.py turns a sample's
# LF into CRLF to check that it reads alike), so LF as TeX writes them
*.synctex text eol=lf
