{
  "about": "Notebook paper: gamma/notebook.py normalize_paper / paper_lines and frontend/src/notebook/notebook.js normalizePaper / paperLines read these cases. `fallback` is the paper missing or bad keys come from (the notebook's default for a sheet); null means the built-in default.",
  "normalize": [
    {"note": "nothing stored: the default", "input": null, "fallback": null,
     "output": {"width": 595.28, "height": 841.89, "color": "#ffffff", "pattern": "blank", "spacing": 24, "line": "#c8d1dc"}},
    {"note": "a full paper stays as it is, colours lowercased", "input": {"width": 612, "height": 792, "color": "#FFF8E7", "pattern": "ruled", "spacing": 20, "line": "#9DB4D0"}, "fallback": null,
     "output": {"width": 612, "height": 792, "color": "#fff8e7", "pattern": "ruled", "spacing": 20, "line": "#9db4d0"}},
    {"note": "missing keys come from the fallback", "input": {"pattern": "grid"}, "fallback": {"width": 612, "height": 792, "spacing": 18},
     "output": {"width": 612, "height": 792, "color": "#ffffff", "pattern": "grid", "spacing": 18, "line": "#c8d1dc"}},
    {"note": "out of range sizes and spacings are clamped, to two decimals", "input": {"width": 50, "height": 99999, "spacing": 3.14159}, "fallback": null,
     "output": {"width": 144, "height": 2000, "color": "#ffffff", "pattern": "blank", "spacing": 12, "line": "#c8d1dc"}},
    {"note": "bad values fall back", "input": {"width": "wide", "height": null, "color": "red", "pattern": "hexagons", "spacing": true, "line": "#12345"}, "fallback": null,
     "output": {"width": 595.28, "height": 841.89, "color": "#ffffff", "pattern": "blank", "spacing": 24, "line": "#c8d1dc"}},
    {"note": "a paper that is not an object is the fallback", "input": "ruled", "fallback": {"pattern": "dots"},
     "output": {"width": 595.28, "height": 841.89, "color": "#ffffff", "pattern": "dots", "spacing": 24, "line": "#c8d1dc"}},
    {"note": "numbers are rounded to hundredths", "input": {"width": 419.527559, "height": 595.275591, "spacing": 22.677}, "fallback": null,
     "output": {"width": 419.53, "height": 595.28, "color": "#ffffff", "pattern": "blank", "spacing": 22.68, "line": "#c8d1dc"}}
  ],
  "lines": [
    {"note": "blank paper has nothing", "paper": {"width": 200, "height": 150, "pattern": "blank", "spacing": 50},
     "lines": [], "dots": []},
    {"note": "ruled: a line every spacing, none on the bottom edge", "paper": {"width": 200, "height": 150, "pattern": "ruled", "spacing": 50},
     "lines": [[0, 50, 200, 50], [0, 100, 200, 100]], "dots": []},
    {"note": "grid: verticals then horizontals", "paper": {"width": 200, "height": 150, "pattern": "grid", "spacing": 50},
     "lines": [[50, 0, 50, 150], [100, 0, 100, 150], [150, 0, 150, 150], [0, 50, 200, 50], [0, 100, 200, 100]], "dots": []},
    {"note": "dots: row by row", "paper": {"width": 160, "height": 150, "pattern": "dots", "spacing": 50},
     "lines": [], "dots": [[50, 50], [100, 50], [150, 50], [50, 100], [100, 100], [150, 100]]},
    {"note": "a fractional spacing keeps its steps exact", "paper": {"width": 150, "height": 150, "pattern": "ruled", "spacing": 36.5},
     "lines": [[0, 36.5, 150, 36.5], [0, 73, 150, 73], [0, 109.5, 150, 109.5], [0, 146, 150, 146]], "dots": []}
  ]
}
