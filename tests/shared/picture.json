    {"note": "a WebP",
     "input": {"url": "/api/uploads/abc.webp"},
     "output": {"url": "/api/uploads/abc.webp", "x": 0, "y": 0, "w": 144, "h": 144, "angle": 0, "crop": {"x": 0, "y": 0, "w": 1, "h": 1}, "flip_h": false, "flip_v": false}},
    {"note": "the extension in any case, kept as written",
