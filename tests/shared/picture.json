{
  "about": "Pictures: gamma/picture.py and frontend/src/markup/picture.js read these cases. `normalize`: `input` is a stored `picture`, `output` the picture both read it as, or null when it is no picture. JSON writes a number past a double's range as 1e999 or a very long integer, which both sides read as infinite. `keep`: a normalized picture kept on a surface of `surface` points (keep_on_surface, keepOnSurface): what is kept on it is the turned frame, which the PDFs cut at the page's edge, so a wide picture turned near an edge has its own corner off the surface. `markdown`: the `![caption](url)` line of a picture whose caption (its content, Markdown) is `content` (markdown_of, pictureMarkdown): the caption read as the words it shows, on one line, without brackets and pipes, escaped once for the alt text. `turned`: the corners of the picture's frame turned about its centre (top-left, top-right, bottom-right, bottom-left of the unturned frame) and their bounding box [x0, y0, x1, y1], both rounded to hundredths (turned_corners and turned_box, turnedCorners and turnedBox).",
  "normalize": [
    {"note": "a url alone is a picture of defaults, 144 pt square at the corner, the whole image, upright",
     "input": {"url": "/api/uploads/3f2a9c.png"},
     "output": {"url": "/api/uploads/3f2a9c.png", "x": 0, "y": 0, "w": 144, "h": 144, "angle": 0, "crop": {"x": 0, "y": 0, "w": 1, "h": 1}, "flip_h": false, "flip_v": false}},
    {"note": "a full picture stays as it is",
     "input": {"url": "/api/uploads/a1B2_c-3.jpg", "x": 72, "y": 100.5, "w": 200, "h": 150.25, "angle": -30, "crop": {"x": 0.1, "y": 0.2, "w": 0.5, "h": 0.25}, "flip_h": true, "flip_v": false},
     "output": {"url": "/api/uploads/a1B2_c-3.jpg", "x": 72, "y": 100.5, "w": 200, "h": 150.25, "angle": -30, "crop": {"x": 0.1, "y": 0.2, "w": 0.5, "h": 0.25}, "flip_h": true, "flip_v": false}},
    {"note": "a JPEG under its long extension",
     "input": {"url": "/api/uploads/abc.jpeg"},
