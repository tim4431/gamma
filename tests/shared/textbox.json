{
  "about": "Text boxes: gamma/text_box.py normalize_text_box and frontend/src/markup/textBox.js normalizeTextBox read these cases. `input` is a stored `text_box`; `output` the box both read it as, or null when it is no text box. JSON writes a number past a double's range as 1e999 or a very long integer, which both sides read as infinite.",
  "normalize": [
    {"note": "an empty object is a box of defaults, one 12 pt line high", "input": {},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a full box stays as it is, colours lowercased", "input": {"x": 72, "y": 100.5, "w": 180, "h": 40, "auto": false, "size": 16, "color": "#C0392B", "bg": "#FFF4B8"},
     "output": {"x": 72, "y": 100.5, "w": 180, "h": 40, "auto": false, "size": 16, "color": "#c0392b", "bg": "#fff4b8"}},
    {"note": "below the range: clamped up", "input": {"x": -10, "y": -0.5, "w": 3, "h": -1, "size": 1},
     "output": {"x": 0, "y": 0, "w": 24, "h": 0, "auto": true, "size": 6, "color": "#1f1f1f", "bg": null}},
    {"note": "above the range: clamped down", "input": {"x": 20000, "y": 14400.5, "w": 99999, "h": 15000, "size": 200},
     "output": {"x": 14400, "y": 14400, "w": 14400, "h": 14400, "auto": true, "size": 96, "color": "#1f1f1f", "bg": null}},
    {"note": "numbers are rounded to hundredths", "input": {"x": 72.3456, "y": 10.004, "w": 180.999, "h": 23.456, "size": 13.337},
     "output": {"x": 72.35, "y": 10, "w": 181, "h": 23.46, "auto": true, "size": 13.34, "color": "#1f1f1f", "bg": null}},
    {"note": "a half hundredth rounds up on both sides, the default height too", "input": {"x": 10.125, "y": 0.625, "size": 10.5},
     "output": {"x": 10.13, "y": 0.63, "w": 200, "h": 21.13, "auto": true, "size": 10.5, "color": "#1f1f1f", "bg": null}},
    {"note": "the default height is one line of the box's size", "input": {"size": 36},
     "output": {"x": 0, "y": 0, "w": 200, "h": 53, "auto": true, "size": 36, "color": "#1f1f1f", "bg": null}},
    {"note": "the default height follows the clamped size", "input": {"size": 2},
     "output": {"x": 0, "y": 0, "w": 200, "h": 15.5, "auto": true, "size": 6, "color": "#1f1f1f", "bg": null}},
    {"note": "values that are not numbers take the default", "input": {"x": "10", "y": null, "w": true, "h": [5], "size": {"pt": 12}},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "an infinite number takes the default, not the bound", "input": {"x": 1e999, "y": -1e999, "w": 1e999, "size": 1e999},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "an integer too long for a double is infinite too", "input": {"x": },
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "bad colours: the default colour and no background", "input": {"color": "red", "bg": "transparent"},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "short and non-hex colours are not colours", "input": {"color": "#fff", "bg": "#12345g"},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "long and numeric colours are not colours", "input": {"color": "#1234567", "bg": 16774328},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a trailing newline is not part of a colour", "input": {"color": "#C0392B\n", "bg": "#FFFFFF\n"},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a null background is no background", "input": {"bg": null},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a background colour is kept, lowercased", "input": {"bg": "#DCECFF"},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": "#dcecff"}},
    {"note": "auto false is a fixed width", "input": {"auto": false},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": false, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "auto: the string false is no boolean, so the default", "input": {"auto": "false"},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "auto: 0 is no boolean, so the default", "input": {"auto": 0},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "auto: null takes the default", "input": {"auto": null},
     "output": {"x": 0, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "unknown keys are dropped", "input": {"x": 5, "text": "hi", "pdf_page": 3, "rotation": 90, "font": "Times"},
     "output": {"x": 5, "y": 0, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "null is no text box", "input": null, "output": null},
    {"note": "a string is no text box", "input": "box", "output": null},
    {"note": "a number is no text box", "input": 12, "output": null},
    {"note": "a boolean is no text box", "input": true, "output": null},
    {"note": "an array is no text box", "input": [{"x": 1}], "output": null}
  ]
}
