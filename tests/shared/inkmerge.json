{
  "about": "Three-way merge of one ink group's strokes: gamma/ink.py merge_ink and frontend/src/ink/ink.js mergeInk read these cases. A stroke is {id, v}; v names a version of that stroke (the loaders build a stroke whose look depends on v), so [\"a\", 1] in a result means stroke a as ours or theirs changed it to version 1. `base` null means the base file is unknown.",
  "cases": [
    {"note": "theirs unchanged: ours wins", "base": [["a", 0]], "ours": [["a", 0], ["b", 0]], "theirs": [["a", 0]],
     "result": [["a", 0], ["b", 0]], "clean": true},
    {"note": "ours unchanged: theirs wins", "base": [["a", 0]], "ours": [["a", 0]], "theirs": [["a", 0], ["x", 0]],
     "result": [["a", 0], ["x", 0]], "clean": true},
    {"note": "both appended: theirs first", "base": [["a", 0]], "ours": [["a", 0], ["b", 0]], "theirs": [["a", 0], ["x", 0]],
     "result": [["a", 0], ["x", 0], ["b", 0]], "clean": true},
    {"note": "ours erased, theirs appended", "base": [["a", 0], ["b", 0]], "ours": [["a", 0]], "theirs": [["a", 0], ["b", 0], ["x", 0]],
     "result": [["a", 0], ["x", 0]], "clean": true},
    {"note": "ours restyled in place, theirs appended", "base": [["a", 0], ["b", 0]], "ours": [["a", 1], ["b", 0]], "theirs": [["a", 0], ["b", 0], ["x", 0]],
     "result": [["a", 1], ["b", 0], ["x", 0]], "clean": true},
    {"note": "both changed one stroke differently: theirs stands", "base": [["a", 0]], "ours": [["a", 1]], "theirs": [["a", 2]],
     "result": [["a", 2]], "clean": false},
    {"note": "both made the same change", "base": [["a", 0], ["b", 0]], "ours": [["a", 1], ["b", 0]], "theirs": [["a", 1], ["b", 0], ["x", 0]],
     "result": [["a", 1], ["b", 0], ["x", 0]], "clean": true},
    {"note": "an edit beats a delete: ours erased what theirs changed", "base": [["a", 0], ["b", 0]], "ours": [["b", 0]], "theirs": [["a", 1], ["b", 0]],
     "result": [["a", 1], ["b", 0]], "clean": false},
    {"note": "an edit beats a delete: theirs erased what ours changed", "base": [["a", 0], ["b", 0]], "ours": [["a", 1], ["b", 0]], "theirs": [["b", 0]],
     "result": [["a", 1], ["b", 0]], "clean": false},
    {"note": "both erased the same stroke", "base": [["a", 0], ["b", 0]], "ours": [["b", 0]], "theirs": [["b", 0], ["x", 0]],
     "result": [["b", 0], ["x", 0]], "clean": true},
    {"note": "undo of an erasure after someone else drew: the stroke returns to its place", "base": [["a", 0], ["b", 0]], "ours": [["a", 0], ["s", 0], ["b", 0]], "theirs": [["a", 0], ["b", 0], ["x", 0]],
     "result": [["a", 0], ["s", 0], ["b", 0], ["x", 0]], "clean": true},
    {"note": "unknown base: a union by stroke id", "base": null, "ours": [["a", 0], ["b", 0]], "theirs": [["a", 0], ["x", 0]],
     "result": [["a", 0], ["x", 0], ["b", 0]], "clean": true},
    {"note": "one id added on both sides differently: theirs stands", "base": [], "ours": [["n", 1]], "theirs": [["n", 2]],
     "result": [["n", 2]], "clean": false},
    {"note": "a stroke added in front", "base": [["a", 0]], "ours": [["s", 0], ["a", 0]], "theirs": [["a", 0], ["x", 0]],
     "result": [["s", 0], ["a", 0], ["x", 0]], "clean": true},
    {"note": "a partial erasure replaces a stroke by its pieces", "base": [["a", 0]], "ours": [["p", 0], ["q", 0]], "theirs": [["a", 0], ["x", 0]],
     "result": [["x", 0], ["p", 0], ["q", 0]], "clean": true},
    {"note": "everything erased here, a stroke added there", "base": [["a", 0], ["b", 0]], "ours": [], "theirs": [["a", 0], ["b", 0], ["x", 0]],
     "result": [["x", 0]], "clean": true}
  ]
}
