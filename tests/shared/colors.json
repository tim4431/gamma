  "with_alpha": [
    {"note": "a half", "color": "#ffe28f", "alpha": 0.5, "out": "#ffe28f80"},
    {"note": "the wash alpha", "color": "#ffe28f", "alpha": 0.65, "out": "#ffe28fa6"},
    {"note": "a tie rounds up (76.5)", "color": "#ffe28f", "alpha": 0.3, "out": "#ffe28f4d"},
    {"note": "the colour's own alpha is replaced", "color": "#ffe28fa6", "alpha": 1, "out": "#ffe28fff"},
    {"note": "not a colour", "color": "nope", "alpha": 0.5, "out": null}
  ],
  "nearest": [
    {"note": "rose reads as red", "color": "#e11d48", "colors": ["#dc2626", "#1d4ed8"], "out": "#dc2626"},
