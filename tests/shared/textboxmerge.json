{
  "about": "Two writers, one text box: gamma/text_box.py merge_text_box and frontend/src/markup/textBox.js mergeTextBox read these cases. A writer changed the box from `base` to `mine` while the server came to hold `stored`; `result` is the box the server stores (the stored box with the keys the writer changed, normalized), or what the writer sent when that is no box.",
  "merge": [
    {"note": "nothing changed meanwhile: the writer's box",
     "stored": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "base": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "mine": {"x": 10, "y": 10, "w": 101.5, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "result": {"x": 10, "y": 10, "w": 101.5, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a keystroke's measured width keeps a move made meanwhile",
     "stored": {"x": 200, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "base": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "mine": {"x": 10, "y": 10, "w": 101.5, "h": 38, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "result": {"x": 200, "y": 10, "w": 101.5, "h": 38, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a move keeps a restyle made meanwhile",
     "stored": {"x": 10, "y": 10, "w": 120, "h": 38, "auto": true, "size": 24, "color": "#dc2626", "bg": "#fff4b8"},
     "base": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "mine": {"x": 40, "y": 55.5, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "result": {"x": 40, "y": 55.5, "w": 120, "h": 38, "auto": true, "size": 24, "color": "#dc2626", "bg": "#fff4b8"}},
    {"note": "a key both changed: the writer's value",
     "stored": {"x": 200, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "base": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "mine": {"x": 50, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "result": {"x": 50, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "the width handle's fixed width keeps a background set meanwhile",
     "stored": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": "#dcecff"},
     "base": {"x": 10, "y": 10, "w": 60, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null},
     "mine": {"x": 10, "y": 10, "w": 150, "h": 23, "auto": false, "size": 12, "color": "#1f1f1f", "bg": null},
     "result": {"x": 10, "y": 10, "w": 150, "h": 23, "auto": false, "size": 12, "color": "#1f1f1f", "bg": "#dcecff"}},
    {"note": "keys are compared normalized: a default spelled out, a rounding within a hundredth and upper case are no change",
     "stored": {"x": 200, "w": 90, "color": "#dc2626"},
     "base": {"x": 10},
     "mine": {"x": 10, "y": 0, "w": 200.004, "h": 23, "auto": true, "size": 12, "color": "#1F1F1F", "bg": null},
     "result": {"x": 200, "y": 0, "w": 90, "h": 23, "auto": true, "size": 12, "color": "#dc2626", "bg": null}},
    {"note": "the writer's values are normalized too",
     "stored": {"x": 10, "y": 10},
     "base": {"x": 10, "y": 10},
     "mine": {"x": -5, "y": 10, "size": 200, "color": "#ABCDEF", "extra": 1},
     "result": {"x": 0, "y": 10, "w": 200, "h": 128, "auto": true, "size": 96, "color": "#abcdef", "bg": null}},
    {"note": "a stored value that is no box: the writer's, normalized",
     "stored": null,
     "base": {"x": 10, "y": 10},
     "mine": {"x": 40, "y": 10},
     "result": {"x": 40, "y": 10, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "a base that is no box: the writer's, normalized",
     "stored": {"x": 200, "y": 10},
     "base": "box",
     "mine": {"x": 40, "y": 10},
     "result": {"x": 40, "y": 10, "w": 200, "h": 23, "auto": true, "size": 12, "color": "#1f1f1f", "bg": null}},
    {"note": "the writer removing the box: as sent",
     "stored": {"x": 200, "y": 10},
     "base": {"x": 10, "y": 10},
     "mine": null,
     "result": null}
  ]
}
