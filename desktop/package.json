{
  "name": "gamma-desktop",
  "version": "0.3.0",
  "description": "Gamma desktop shell: opens local and remote Gamma servers",
  "homepage": "https://github.com/tim4431/Gamma",
  "author": "Tim <tim4431@users.noreply.github.com>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "store-art": "node scripts/store-art.js",
    "start": "electron .",
    "test": "node --test test/keeping.test.js test/cloudSignIn.test.js test/sidecar.test.js test/openFiles.test.js test/hostPath.test.js test/folderAccess.test.js test/microphone.test.js test/registry.test.js test/main.test.js",
    "smoke": "node test/smoke.js",
    "smoke:packaged": "node test/smoke.js --packaged",
    "e2e": "node test/e2e.js",
    "e2e:packaged": "node test/e2e.js --packaged",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mas": "umask 022 && electron-builder --config electron-builder.mas.cjs --mac mas --publish never",
    "pack:mas-dev": "umask 022 && electron-builder --config electron-builder.mas.cjs --mac mas-dev --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.55.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
