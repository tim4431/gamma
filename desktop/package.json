{
  "name": "gamma-desktop",
  "version": "0.1.0",
  "description": "Gamma desktop shell: opens local and remote Gamma workspaces",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.tim4431.gamma",
    "productName": "Gamma",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "launcher/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/gamma-server",
        "to": "gamma-server"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    }
  }
}
