services:
  gamma:
    container_name: gamma
    image: ghcr.io/tim4431/gamma:latest
    build: .
    ports:
      - "9001:9001"
    volumes:
      # Named volume: Docker manages the storage location. To keep the data in
      # a real folder next to this file instead, use a bind mount:
      #   - ./data:/data
      - gamma-data:/data
    # environment:
      # With a bind mount, set these to your host user's ids (`id -u` / `id -g`)
      # so the files Gamma creates belong to you instead of root:
      # PUID: 1000
      # PGID: 1000
      # Behind a reverse proxy (Caddy, nginx for a domain with TLS), the
      # proxy's address, so Gamma believes its X-Forwarded-For and rate
      # limits count each visitor instead of the proxy. For a proxy container
      # in this file, the subnet of the network below (pinned, so it is
      # known). Leave it unset when nothing sits in front of the port. The
      # proxy needs no compression of its own for the app's files: Gamma
      # sends the Brotli or gzip copies its build made.
      # FORWARDED_ALLOW_IPS: 10.203.0.0/24
      # Off-site copies: the databases and the uploaded files copied to an
      # S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) every hour, the
      # newest seven copies of each database kept; Gamma keeps running on
      # the data volume. An admin can set this in Settings -> Backups
      # instead; with GAMMA_S3_BUCKET set, these variables decide and the
      # pane shows them read-only. The bucket needs no CORS rule.
      # `manage.py offsite` lists and restores the copies
      # (docs/dev/debugging.md "Off-site copies in a bucket").
      # GAMMA_S3_BUCKET: gamma-backups
      # GAMMA_S3_ENDPOINT: https://<account>.r2.cloudflarestorage.com   # unset for AWS
      # GAMMA_S3_REGION: auto
      # GAMMA_S3_ACCESS_KEY: ...
      # GAMMA_S3_SECRET_KEY: ...
      # GAMMA_S3_PREFIX: gamma                 # optional: one prefix per server sharing the bucket
      # GAMMA_OFFSITE: "1"                     # the default with a bucket; "0" turns the copies off
      # GAMMA_OFFSITE_INTERVAL: "3600"         # seconds, at least 60
      # GAMMA_OFFSITE_KEEP: "7"
    restart: unless-stopped

  # Litestream, for when seconds of loss matter: it streams every database
  # to the off-site bucket as it changes (the copies above are the simpler
  # default, and the only ones of the uploaded files). Write its
  # configuration first, and again, followed by `docker compose restart
  # litestream`, whenever a workspace is added or deleted, since Litestream
  # does not watch it:
  #   docker exec gamma python manage.py litestream-config --out /data/litestream.yml
  # docs/dev/debugging.md "Litestream".
  # litestream:
  #   container_name: gamma-litestream
  #   image: litestream/litestream
  #   command: replicate -config /data/litestream.yml
  #   volumes:
  #     - gamma-data:/data                   # the same volume, at the same path
  #   environment:                           # the keys the configuration names
  #     GAMMA_S3_ACCESS_KEY: ...
  #     GAMMA_S3_SECRET_KEY: ...
  #   restart: unless-stopped

  # Keeps the gamma container on the newest image: Watchtower polls the
  # registry every six hours, pulls a new image and restarts gamma, which
  # upgrades its data directory at startup (a snapshot of the databases is
  # taken first; see docs/dev/migrations.md). Scoped to this container, so
  # it never touches others on the host. Remove the service to update by
  # hand with `docker compose pull && docker compose up -d`.
  watchtower:
    container_name: gamma-watchtower
    image: containrrr/watchtower
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    command: --cleanup --interval 21600 gamma
    restart: unless-stopped

volumes:
  gamma-data:

# With a proxy container next to gamma, pin the compose network's subnet and
# name it in FORWARDED_ALLOW_IPS above:
# networks:
#   default:
#     ipam:
#       config:
#         - subnet: 10.203.0.0/24
