/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com https://account.gammapdf.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Link: </media/inter.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin

# Brand artwork, demos and the font change rarely and are re-copied on every build.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The guide's demos have their own styles and never use the font.
/docs/demos/*
  ! Link
