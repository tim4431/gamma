# Copy to .env next to compose.yml and chmod 600: the token and the bucket
# key are secrets. Compose hands every line to the agent (env_file); the
# docstring at the top of cloud/fleet/gammafleet/agent.py describes each.
# The commented lines show the agent's defaults.

# The account server, over its public address. The agent only ever calls out
# to it, so a host anywhere needs this and the token, nothing else.
GAMMA_FLEET_ACCOUNT_URL=https://account.gammapdf.com
# This host's token, shown once by Admin → Servers → Add host (or manage.py add-host).
GAMMA_FLEET_HOST_TOKEN=

# The network the hosted containers join; compose.yml joins the agent to gamma-fleet by name.
#GAMMA_FLEET_NETWORK=gamma-fleet
# Where a server's data goes (<root>/<label>/data); compose.yml mounts /srv/gamma at this path.
#GAMMA_FLEET_DATA_ROOT=/srv/gamma
# A container's memory limit in MB when its job names none; the account server names the plan's own.
#GAMMA_FLEET_MEMORY_MB=768
# A container's CPUs when its job names none, likewise.
#GAMMA_FLEET_CPUS=1

# The off-site bucket (any S3-compatible store) every hosted server copies to,
# under <prefix><account id>/. Empty bucket = no off-site copies. Every host
# of the fleet uses the same bucket.
GAMMA_FLEET_S3_BUCKET=
# The store's endpoint URL, e.g. https://<account id>.r2.cloudflarestorage.com.
GAMMA_FLEET_S3_ENDPOINT=
# The region, where the store wants one (R2: auto).
GAMMA_FLEET_S3_REGION=
# The access key id of a key that may read, write and delete in that bucket only.
GAMMA_FLEET_S3_ACCESS_KEY=
# Its secret. Every hosted container gets both as GAMMA_S3_*, so scope the key to the bucket.
GAMMA_FLEET_S3_SECRET_KEY=
# The key prefix under which each account's folder is made.
#GAMMA_FLEET_S3_PREFIX=hosted/

# A host with a public IP of its own runs compose.yml's Caddy as well (README.md
# "A second host"); bootstrap.sh --edge sets this. Never on the account server's VPS.
#COMPOSE_PROFILES=edge
# That Caddy's zone, and the suffix of every hosted server's name: the account
# server's GAMMA_CLOUD_HOSTED_DOMAIN and GAMMA_CLOUD_HOSTED_SUFFIX.
#GAMMA_FLEET_DOMAIN=gammapdf.com
#GAMMA_FLEET_SUFFIX=-user
