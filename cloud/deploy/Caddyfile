# TLS for the account server. The hostname is proxied by Cloudflare, so the
# public certificate is Cloudflare's; between Cloudflare and this host Caddy
# serves its own internal certificate (Cloudflare SSL/TLS mode "Full").
# Let's Encrypt cannot validate a proxied hostname, hence `tls internal`. For
# "Full (strict)" install a Cloudflare Origin CA certificate instead:
#   tls /certs/origin.pem /certs/origin.key
{$CADDY_HOST} {
	tls internal
	encode gzip
	reverse_proxy account:9002
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# The shared server and every account's page host (app.gammapdf.com, its
# publishing address share.gammapdf.com, and <username>-pages.gammapdf.com),
# the public demo (demo.gammapdf.com) and the hosted servers
# (<username>-user.gammapdf.com) — one wildcard site. Named records such as
# account.gammapdf.com win over the wildcard, and the internal certificate
# covers *.gammapdf.com, so no DNS challenge is needed (Cloudflare "Full").
# Anything else under the wildcard is a 404: a hosted server's name always
# ends in -user, so no username can shadow a service name.
#
# The demo is its own compose project (cloud/deploy/demo/): Caddy reaches
# it as `gamma-demo` on the shared network `gamma-edge`, resolved per
# request, so a stopped demo is a 502 for its name and nothing else.
#
# Every Gamma behind this Caddy (the share host at app.gammapdf.com and
# share.gammapdf.com and its page hosts, the demo, the hosted servers) rate
# limits per client address: sign-ins, guest logins, unknown share links.
# The Gamma image takes that address from X-Forwarded-For only when the
# connection comes from an address its FORWARDED_ALLOW_IPS lists (uvicorn
# --proxy-headers): the share host names this project's pinned network, the
# demo gamma-edge's subnet, a hosted server gamma-fleet's. Caddy does not
# trust the X-Forwarded-For Cloudflare sends and would put Cloudflare's edge
# address there, so every visitor behind one edge would share one limit:
# each Gamma route passes Cloudflare's CF-Connecting-IP instead (see the
# README's origin lock-down note on who can set that header). The account
# server above reads CF-Connecting-IP itself.
*.gammapdf.com {
	tls internal
	encode gzip
	@pages header_regexp Host ^[a-z0-9-]+-pages\.gammapdf\.com$
	@share host app.gammapdf.com share.gammapdf.com
	@demo host demo.gammapdf.com
	handle @share {
		reverse_proxy share:9001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle @demo {
		reverse_proxy gamma-demo:9001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle @pages {
		reverse_proxy share:9001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	# Every other <label>.gammapdf.com is a hosted Gamma server: the fleet
	# agent names its container gamma-<label> on the external network
	# gamma-fleet, which Caddy joins (labels count from the right: com is 0,
	# gammapdf 1, the label 2). The name is resolved per request, so a
	# stopped or unknown server is a 502 for its name and nothing else.
	@hosted header_regexp hosted Host ^([a-z0-9][a-z0-9-]*)-user\.gammapdf\.com$
	handle @hosted {
		reverse_proxy gamma-{re.hosted.1}:9001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		respond 404
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
