# Copy to share.env next to compose.yml: the free share host's settings, a
# Gamma in cloud mode (docs/dev/cloud_accounts.md "The share host"). The
# client id and secret come from `manage.py create-client "Share host"
# share-host https://share.gammapdf.com/api/auth/cloud/callback` on the
# account server; the admin subject is the cloud account id (the `sub`) of
# the person who administers the share host.

GAMMA_PUBLIC_URL=https://share.gammapdf.com
GAMMA_CLOUD_ISSUER=https://account.gammapdf.com
GAMMA_CLOUD_CLIENT_ID=
GAMMA_CLOUD_CLIENT_SECRET=
GAMMA_CLOUD_POLICY=provision
GAMMA_CLOUD_SHARE_HOST=1
GAMMA_PAGE_HOST={username}-pages.gammapdf.com
GAMMA_CLOUD_ADMIN_SUBJECT=
# GAMMA_FREE_PAGE_LIMIT=5
