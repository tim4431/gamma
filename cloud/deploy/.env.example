# Copy to .env next to compose.yml. Every value is read by the account server
# (cloud/gammacloud/config.py) except CADDY_HOST and TUNNEL_TOKEN, which the
# proxies read. The fleet agent's settings (GAMMA_FLEET_*) are not here: it is
# its own compose project with its own .env (cloud/fleet/deploy/).
#
# Registration mode, Turnstile and blocked mail domains are not set here: an
# admin edits them on the Admin page's Settings tab (README.md "The sign-up
# settings").

# The public address — the OIDC issuer every Gamma server verifies against.
GAMMA_CLOUD_PUBLIC_URL=https://account.gammapdf.com
GAMMA_CLOUD_DATA_DIR=/data

# Mail: verify, reset and change-e-mail links. Any SMTP submission service.
GAMMA_CLOUD_MAIL=smtp
GAMMA_CLOUD_MAIL_FROM=Gamma Cloud <no-reply@gammapdf.com>
GAMMA_CLOUD_SMTP_HOST=smtp.example.com
GAMMA_CLOUD_SMTP_PORT=587
GAMMA_CLOUD_SMTP_USER=
GAMMA_CLOUD_SMTP_PASSWORD=
GAMMA_CLOUD_SMTP_STARTTLS=1

# Sign in with Google / GitHub (README.md → "Sign in with Google and GitHub").
# A provider is offered only when both of its values are set. Callbacks:
# <public url>/oauth/google/callback and <public url>/oauth/github/callback.
GAMMA_CLOUD_GOOGLE_CLIENT_ID=
GAMMA_CLOUD_GOOGLE_CLIENT_SECRET=
GAMMA_CLOUD_GOOGLE_ONE_TAP=1
GAMMA_CLOUD_GITHUB_CLIENT_ID=
GAMMA_CLOUD_GITHUB_CLIENT_SECRET=

# The free share host (the compose service `share`, settings in share.env):
# its address, handed to every Gamma server so "Publish" knows where to go.
# Empty = no share host, Publish is off everywhere.
GAMMA_CLOUD_SHARE_HOST_URL=https://share.gammapdf.com
# The same server under the address people use: the entrance, where every
# account signs in and a Lite or Plus library lives. Unset = the share
# host's address above.
GAMMA_CLOUD_APP_URL=https://app.gammapdf.com

# The built-in public OIDC client every local Gamma is (default gamma-desktop
# from config.py; normally unchanged).
GAMMA_CLOUD_DESKTOP_CLIENT_ID=

# Billing (docs/dev/billing.md). Off while the secret is empty: no checkout,
# no plan page purchase. Stripe sends its events to
# POST <public url>/api/billing/webhook, signed with the webhook secret.
GAMMA_CLOUD_STRIPE_SECRET=
GAMMA_CLOUD_STRIPE_WEBHOOK_SECRET=
# The Stripe Price id behind each plan and interval.
GAMMA_CLOUD_STRIPE_PRICE_LITE_MONTH=
GAMMA_CLOUD_STRIPE_PRICE_LITE_YEAR=
GAMMA_CLOUD_STRIPE_PRICE_PLUS_MONTH=
GAMMA_CLOUD_STRIPE_PRICE_PLUS_YEAR=
GAMMA_CLOUD_STRIPE_PRICE_PRO_MONTH=
GAMMA_CLOUD_STRIPE_PRICE_PRO_YEAR=

# Hosted servers (README.md "Hosted servers"; docs/dev/hosted.md). The domain
# a server answers under as <username>-user.<domain> (the suffix is
# GAMMA_CLOUD_HOSTED_SUFFIX; the Caddyfile's @hosted rule must match it);
# empty = hosting is off (no server is created). The image and default tag the fleet starts.
GAMMA_CLOUD_HOSTED_DOMAIN=
GAMMA_CLOUD_FLEET_IMAGE=ghcr.io/tim4431/gamma
GAMMA_CLOUD_FLEET_IMAGE_TAG=latest
# A second fleet host (../fleet/deploy/README.md "A second host"): a Cloudflare
# API token with DNS edit rights on the hosting domain's zone, and the zone's id.
# With both, each server on a host with a public IP gets a DNS record of its
# own; without them such a host takes no servers.
GAMMA_CLOUD_CF_API_TOKEN=
GAMMA_CLOUD_CF_ZONE_ID=

# The hostname Caddy serves (compose.yml): its DNS record must point at this
# host. Unused with compose.tunnel.yml.
CADDY_HOST=account.gammapdf.com

# Only with compose.tunnel.yml: the Cloudflare Tunnel connector token (Zero
# Trust → Networks → Tunnels); the tunnel's public hostname must point at
# http://account:9002.
TUNNEL_TOKEN=
