# Copy to .env next to compose.yml. Compose reads it to fill in the image
# tag; the container never sees it (its settings are demo.env). The
# update-demo-server skill rewrites this line to the build it deploys: the
# `sha-<7 hex>` tag of main's newest docker.yml run (pinned, not :latest).
GAMMA_TAG=sha-44e8969
# The subnet of the gamma-edge network Caddy reaches the demo over: the demo
# believes X-Forwarded-For from it only (FORWARDED_ALLOW_IPS), so its guest
# logins are limited per visitor. The network made as the README says has
# this one; an older one has its own:
#   docker network inspect gamma-edge --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
EDGE_SUBNET=10.202.0.0/24
