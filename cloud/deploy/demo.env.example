# Copy to demo.env next to compose.yml: the public demo's settings, a Gamma
# in demo mode (docs/dev/guests.md "Demo mode"). Every visitor gets a
# throwaway guest account that is deleted after GAMMA_GUEST_TTL_HOURS. The
# variables are read at start: `docker compose up -d demo` after an edit.

GAMMA_PUBLIC_URL=https://demo.gammapdf.com
GAMMA_DEMO=1
GAMMA_GUEST_TTL_HOURS=24
# Live guest accounts at once; the next "Try the demo" answers 503 until the
# sweeper frees one. Each guest is a workspace directory (plus a copy of the
# seed below), so disk use grows up to this many of them.
GAMMA_GUEST_MAX=300

# The first admin, seeded once on the empty data directory and never read
# again (gamma/seed.py). Leave the password empty for a random one printed
# once to `docker compose logs demo`, and change it after signing in.
GAMMA_ADMIN_USER=admin
GAMMA_ADMIN_PASSWORD=

# Optional: the sample library every guest starts from, restored into each
# new guest's workspace. Make it from a workspace prepared on any Gamma
# (the admin's own on this server will do): Settings → Workspaces → Export,
# or a snapshot downloaded from Settings → Backups. Copy that zip to
# ./demo-data/guest-seed.zip on the host, uncomment the line, and restart.
# Keep it small: every guest gets its own copy.
# GAMMA_GUEST_SEED=/data/guest-seed.zip

# AI keys are never environment variables. After the first start the admin
# signs in (Admin sign-in on the login page), adds a shared key under
# Settings → Server → Shared AI provider, turns "Guests may use it" on and
# sets the per-guest allowance (tokens per 24 h) so one visitor cannot spend
# it all.
